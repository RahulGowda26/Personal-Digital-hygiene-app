{
  "manifest_version": 3,
  "name": "Sentinel Web Protection",
  "version": "1.0.0",
  "description": "Real-time web protection and suspicious link scanner companion for the Sentinel app.",
  "permissions": [
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Sentinel Web Protection"
  }
}
